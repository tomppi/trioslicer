<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- The OctoPrint file holds an API key encrypted with a Keystore key
             that never leaves this device, so a restored copy is ciphertext
             nothing can decrypt. The harness file is the same shape: its launch
             token and 30-day session cookie are sealed with a device-bound key,
             and they name a harness that can run code on its host. The address,
             workspace path and session ids beside them are this device's
             business with a host the restored device has never spoken to. -->
        <exclude domain="sharedpref" path="octoprint_client.xml" />
        <exclude domain="sharedpref" path="harness_config.xml" />
        <exclude domain="sharedpref" path="klipper-host.xml" />
        <exclude domain="file" path="smart-infill/" />
        <!-- Everything else the app writes under files/ stays behind too: none
             of it is worth restoring on another device, and most of it is far
             too big for a backup that is capped at 25 MB in total. blender/ is
             the extracted engine tree (~480 MB, and it carries the MCP shared
             secret in scripts/startup/blender_mcp_token.txt), models/ holds the
             imported and staged STLs, slice-results/ the sliced G-code and
             thermal-fea/ the FEA reports. orca/ and prusa/ stage the engine
             bundles and datadirs, logs/ holds the engine logs, annotations/
             the saved measurement annotations and crash.log the last crash
             report. One of them alone puts the whole backup over quota, and an
             over-quota Auto Backup is not a partial one: it fails, settings
             included, which is exactly what this backup exists for. All of it
             is regenerated on the new device, blender-home/ (the engine's own
             HOME: temp, cache and generated config) included. -->
        <exclude domain="file" path="blender/" />
        <exclude domain="file" path="blender-home/" />
        <exclude domain="file" path="models/" />
        <exclude domain="file" path="slice-results/" />
        <exclude domain="file" path="thermal-fea/" />
        <!-- persistent-state/ used to be excluded whole, and that took the
             saved preset library with it. The library is user-presets.json
             beside its rollback copy user-presets.previous.json - which can be
             the only intact copy after an interrupted write - and both are
             deliberately restored now, the point of this backup beside the
             settings. Only the exact files below stay behind. The workspace
             descriptor (with its staged .next and rollback .previous copies)
             names absolute model paths under files/models that do not exist on
             the receiving device, so it would restore a plate of dangling
             references. The imported Cura project bundle is a copy of a
             configuration the user still has, up to 128 MiB and past the 25 MB
             quota, so the bundle, its .bin predecessor, its .materialized
             payload and its .tmp/.next/.previous staged and rollback writes
             all stay behind with it. And user-presets.next.json is the preset
             store's staging file, which no load path reads and every save
             deletes before writing a new one. -->
        <exclude domain="file" path="persistent-state/current-workspace.json" />
        <exclude domain="file" path="persistent-state/current-workspace.next" />
        <exclude domain="file" path="persistent-state/current-workspace.previous" />
        <exclude domain="file" path="persistent-state/current-cura-import.bin" />
        <exclude domain="file" path="persistent-state/current-cura-import.bundle" />
        <exclude domain="file" path="persistent-state/current-cura-import.bundle.next" />
        <exclude domain="file" path="persistent-state/current-cura-import.bundle.previous" />
        <exclude domain="file" path="persistent-state/current-cura-import.materialized" />
        <exclude domain="file" path="persistent-state/current-cura-import.materialized.next" />
        <exclude domain="file" path="persistent-state/current-cura-import.tmp" />
        <exclude domain="file" path="persistent-state/user-presets.next.json" />
        <exclude domain="file" path="orca/" />
        <exclude domain="file" path="prusa/" />
        <exclude domain="file" path="logs/" />
        <exclude domain="file" path="annotations/" />
        <exclude domain="file" path="crash.log" />
        <!-- And the printer side, which the Klipper work added afterwards: gcodes/
             holds a copy of everything printed, never reaped, and klipper-host/ the
             running printer.cfg with the calibrations klippy has saved in it. The
             first is regenerable and large, the second names this phone's paths and
             can be exported from the Machine screen. -->
        <exclude domain="file" path="gcodes/" />
        <exclude domain="file" path="klipper-host/" />
        <exclude domain="file" path="printer-pty" />
        <!-- And the CAD engine's tree: the engine's home, its Python packages and
             its exports, ~570 MB across 13,000 files, with cad_mcp_token.txt - the
             32-byte bearer secret for port 9877 - among them. Holding that token
             means running arbitrary Python as this app, so it must not leave the
             device; the replacement extracts the tree from the app's assets again
             and writes a fresh token beside it. -->
        <exclude domain="file" path="cad/" />
    </cloud-backup>
    <device-transfer>
        <!-- As in the cloud-backup rules above: the OctoPrint credential is
             device-bound, the harness credentials no longer decrypt on another
             device, and what is left names a host this device knows. -->
        <exclude domain="sharedpref" path="octoprint_client.xml" />
        <exclude domain="sharedpref" path="harness_config.xml" />
        <exclude domain="sharedpref" path="klipper-host.xml" />
        <exclude domain="file" path="smart-infill/" />
        <!-- And the printer side, which the Klipper work added afterwards: gcodes/
             holds a copy of everything printed, never reaped, and klipper-host/ the
             running printer.cfg with the calibrations klippy has saved in it. The
             first is regenerable and large, the second names this phone's paths and
             can be exported from the Machine screen. -->
        <exclude domain="file" path="gcodes/" />
        <exclude domain="file" path="klipper-host/" />
        <exclude domain="file" path="printer-pty" />
        <!-- And the same files/ directories: a replacement device has no use for
             half a gigabyte of engine tree and its scratch home, models,
             G-code or FEA reports it imports or generates itself - nor for the
             staged engine bundles in orca/ and prusa/, the logs/, the saved
             annotations/ or crash.log. -->
        <exclude domain="file" path="blender/" />
        <exclude domain="file" path="blender-home/" />
        <exclude domain="file" path="models/" />
        <exclude domain="file" path="slice-results/" />
        <exclude domain="file" path="thermal-fea/" />
        <!-- What travels from persistent-state/ now is the saved preset library:
             user-presets.json with its rollback copy user-presets.previous.json
             is the whole point of moving the library to a replacement device,
             so the directory is no longer excluded. The workspace descriptor
             and its staged .next and rollback .previous copies stay behind -
             they name absolute model paths under files/models the replacement
             device does not have, and would restore a plate of dangling
             references. The imported Cura project bundle is a copy of a
             configuration the user still has, up to 128 MiB; its .bin
             predecessor, .materialized payload and .tmp/.next/.previous staged
             and rollback writes are the same bytes and stay behind with it.
             user-presets.next.json is the preset store's staging file, which
             no load path reads and every save deletes before writing a new
             one. -->
        <exclude domain="file" path="persistent-state/current-workspace.json" />
        <exclude domain="file" path="persistent-state/current-workspace.next" />
        <exclude domain="file" path="persistent-state/current-workspace.previous" />
        <exclude domain="file" path="persistent-state/current-cura-import.bin" />
        <exclude domain="file" path="persistent-state/current-cura-import.bundle" />
        <exclude domain="file" path="persistent-state/current-cura-import.bundle.next" />
        <exclude domain="file" path="persistent-state/current-cura-import.bundle.previous" />
        <exclude domain="file" path="persistent-state/current-cura-import.materialized" />
        <exclude domain="file" path="persistent-state/current-cura-import.materialized.next" />
        <exclude domain="file" path="persistent-state/current-cura-import.tmp" />
        <exclude domain="file" path="persistent-state/user-presets.next.json" />
        <exclude domain="file" path="orca/" />
        <exclude domain="file" path="prusa/" />
        <exclude domain="file" path="logs/" />
        <exclude domain="file" path="annotations/" />
        <exclude domain="file" path="crash.log" />
        <!-- And the CAD engine's tree: the engine's home, its Python packages and
             its exports, ~570 MB across 13,000 files, with cad_mcp_token.txt - the
             32-byte bearer secret for port 9877 - among them. Holding that token
             means running arbitrary Python as this app, so a replacement device
             gets the tree from the app's assets again and mints its own. -->
        <exclude domain="file" path="cad/" />
    </device-transfer>
</data-extraction-rules>
