<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Foreground service keeps the embedded engine alive with the screen off/locked. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <uses-feature android:glEsVersion="0x00020000" android:required="true" />
    <!-- USB host, for driving a Klipper printer board over a USB-serial chip.
         Not required: the app installs and works without OTG, and the feature is
         asked for at runtime when a printer is plugged in. -->
    <uses-feature android:name="android.hardware.usb.host" android:required="false" />

    <application
        android:name=".EnderSlicerApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:largeHeap="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.EnderSlicer">
        <activity
            android:name=".smartinfill.SmartInfillActivity"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|density|fontScale|touchscreen|keyboard|keyboardHidden|uiMode"
            android:exported="false" />
        <activity
            android:name=".texturizer.BumpMeshActivity"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|density|fontScale|touchscreen|keyboard|keyboardHidden|uiMode"
            android:exported="false" />
        <!-- Embedded Blender MCP engine keeper: foreground service so the
             process survives screen-off/lock (no service => cached process,
             culled by the OS once the screen locks). -->
        <service
            android:name=".nativebridge.BlenderEngineService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Embedded Blender MCP generation engine; keeps the socket server and STL handoff alive while the UI is not foregrounded." />
        </service>

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <provider
            android:name=".storage.OneShotExportFileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
