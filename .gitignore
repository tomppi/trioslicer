*.iml
__pycache__/
.gradle/
.idea/
.kotlin/
local.properties
.DS_Store
build/
**/build/
# CI engine snapshots and build logs (.github/workflows/prusa-engine-android.yml):
# they are published as workflow artifacts, never committed - the 2.9.6 engine
# that used to live here is 90 MB that nothing in the tree reads.
.build-artifacts/
.externalNativeBuild/
.cxx/
.build/
app/src/main/jniLibs/
app/src/main/assets/cura/definitions/
app/src/main/assets/bumpmesh/
app/src/main/assets/filasim/
# The PrusaSlicer resources are staged by scripts/fetch-prusa-engine-android.sh.
# app/src/main/assets/prusa/all-settings.json is the catalogue derived from them
# (scripts/generate-prusa-all-settings.py) and is committed: the engine has no
# dump mode, so it is the one file under prusa/ git must keep.
app/src/main/assets/prusa/*
!app/src/main/assets/prusa/all-settings.json
# The PrusaSlicer preset repository's JSON view is generated from the YAML the engine ships,
# by scripts/prusa-presets-to-json.py, during scripts/fetch-prusa-engine-android.sh.
app/src/main/assets/prusa-presets.json
# The Orca profile tree comes from the engine checkout (scripts/stage-orca-resources.sh);
# its 202 KB settings catalogue is generated by "orca-console --dump-settings" and is
# committed, because it is small, stable, and the only record of the option names the
# shipped engine accepts.
app/src/main/assets/orca/resources/

# Session scratch / local-only artifacts
.fw-src/
.venv-fw/
cura/
screenshot*.png
scripts/_*.py
scripts/_*.sh
scripts/_*.bat
docs/suture-walls-concept.png
docs/zipper-bond-concept.png
docs/zipper-bond-v2.png

# Blender MCP engine (arm64-only, staged by the engine build; not committed)
app/src/main/assets/blender/
native/blender/blender-jniLibs/
native/blender/blender-gensrc/

# DSH harness session artifacts (renders, STL pulls, APK checks) — never commit
.dsh-build/

# DSH harness local workspace config — keep local
.dsh/*

# Agent scratch dirs and payload chunks (base64 archives, patch bundles) — never commit
.agent-*/
.agent-*

# Release signing: the key is private and keystore.properties carries its
# passwords. Neither is ever committed - see keystore/README.md.
keystore.properties
*.jks
*.keystore
