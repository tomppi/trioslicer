diff --git a/deps/MPFR/MPFR.cmake b/deps/MPFR/MPFR.cmake
index 755a7699..1ef1b31b 100644
--- a/deps/MPFR/MPFR.cmake
+++ b/deps/MPFR/MPFR.cmake
@@ -19,21 +19,48 @@ if (MSVC)
 else ()
 
     set(_cross_compile_arg "")
-    if (CMAKE_CROSSCOMPILING)
+    if (CMAKE_CROSSCOMPILING AND NOT ANDROID)
         # TOOLCHAIN_PREFIX should be defined in the toolchain file
         set(_cross_compile_arg --host=${TOOLCHAIN_PREFIX})
     endif ()
 
+    # The MPFR release tarball ships a configure that already understands an
+    # aarch64-linux-android host, so the autoreconf pass (and with it a host
+    # autoconf/automake/libtool installation) is not needed on Android.
+    set(_autoreconf "autoreconf -f -i &&")
+    set(_maintainer_arg "")
+    if (ANDROID)
+        set(_autoreconf "")
+        # MPFR turns maintainer mode on by default, and its rules then try to regenerate
+        # configure and Makefile.in with autoconf/automake, which are not dependencies of
+        # this port. --disable-maintainer-mode drops those rules instead of faking
+        # timestamps, which would only make config.status want to re-run configure.
+        set(_maintainer_arg "--disable-maintainer-mode")
+    endif ()
+
     ExternalProject_Add(dep_MPFR
         URL https://ftp.gnu.org/gnu/mpfr/mpfr-4.2.2.tar.bz2
             https://www.mpfr.org/mpfr-4.2.2/mpfr-4.2.2.tar.bz2
         URL_HASH SHA256=9ad62c7dc910303cd384ff8f1f4767a655124980bb6d8650fe62c815a231bb7b
         DOWNLOAD_DIR ${DEP_DOWNLOAD_DIR}/MPFR
         BUILD_IN_SOURCE ON
-        CONFIGURE_COMMAND autoreconf -f -i && 
-                          env "CC=${CMAKE_C_COMPILER}" "CXX=${CMAKE_CXX_COMPILER}" "CFLAGS=${_gmp_ccflags}" "CXXFLAGS=${_gmp_ccflags}" "LDFLAGS=${CMAKE_EXE_LINKER_FLAGS}" ./configure ${_cross_compile_arg} --prefix=${DESTDIR} --enable-shared=no --enable-static=yes --with-gmp=${DESTDIR} ${_gmp_build_tgt}
+        CONFIGURE_COMMAND ${_autoreconf} 
+                          env "CC=${_gmp_cc}" "CXX=${_gmp_cxx}" "CFLAGS=${_gmp_ccflags}" "CXXFLAGS=${_gmp_ccflags}" "LDFLAGS=${CMAKE_EXE_LINKER_FLAGS}" ./configure ${_cross_compile_arg} ${_maintainer_arg} --prefix=${DESTDIR} --enable-shared=no --enable-static=yes --with-gmp=${DESTDIR} ${_gmp_build_tgt}
         BUILD_COMMAND make -j
         INSTALL_COMMAND make install
         DEPENDS dep_GMP
     )
+
+    # MPFR ships its Texinfo manual, and the extracted timestamps land in the same second
+    # as mpfr.texi, so make decides the manual is stale and calls makeinfo through
+    # automake's "missing" wrapper, which reports error 127. Touching the shipped manual
+    # keeps the documentation out of the build. configure is deliberately left alone:
+    # touching it would instead make config.status want to re-run configure.
+    ExternalProject_Add_Step(dep_MPFR keep_prebuilt_manual
+        DEPENDEES patch
+        DEPENDERS build
+        COMMENT "Keeping MPFR's prebuilt Texinfo manual"
+        WORKING_DIRECTORY ${CMAKE_BINARY_DIR}/dep_MPFR-prefix/src/dep_MPFR
+        COMMAND ${CMAKE_COMMAND} -E touch doc/mpfr.info
+    )
 endif ()
diff --git a/deps/OpenSSL/OpenSSL.cmake b/deps/OpenSSL/OpenSSL.cmake
index 21a49b91..5efd8824 100644
