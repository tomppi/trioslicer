diff --git a/deps/CMakeLists.txt b/deps/CMakeLists.txt
index dbbf9a04..162b3204 100644
--- a/deps/CMakeLists.txt
+++ b/deps/CMakeLists.txt
@@ -45,6 +45,44 @@ if (CMAKE_SYSTEM_NAME STREQUAL "Linux" AND CMAKE_VERSION VERSION_LESS "3.25")
     set(LINUX ON CACHE BOOL "" FORCE)
 endif ()
 
+option(SLIC3R_GUI "Build GUI-only dependencies (GLEW, GLFW, OpenCSG, wxWidgets, OpenCV)" ON)
+option(SLIC3R_CAD "Build the CAD-tab dependency (OCCT)" ON)
+
+# The autotools recipes (GMP, MPFR) and OpenSSL cannot read the NDK toolchain, so the
+# target triplet each of them expects is derived here from the ABI being built.
+if (ANDROID)
+    if (ANDROID_ABI STREQUAL "arm64-v8a")
+        set(ORCA_ANDROID_HOST aarch64-linux-android)
+        set(ORCA_ANDROID_OPENSSL_TARGET android-arm64)
+    elseif (ANDROID_ABI STREQUAL "armeabi-v7a")
+        set(ORCA_ANDROID_HOST armv7a-linux-androideabi)
+        set(ORCA_ANDROID_OPENSSL_TARGET android-arm)
+    elseif (ANDROID_ABI STREQUAL "x86_64")
+        set(ORCA_ANDROID_HOST x86_64-linux-android)
+        set(ORCA_ANDROID_OPENSSL_TARGET android-x86_64)
+    else ()
+        message(FATAL_ERROR "Unsupported ANDROID_ABI for the OrcaSlicer dependency build: ${ANDROID_ABI}")
+    endif ()
+    string(REPLACE "android-" "" ORCA_ANDROID_API_LEVEL "${ANDROID_PLATFORM}")
+
+    # The NDK toolchain hands CMake a plain clang and passes the target through
+    # CMAKE_C_COMPILER_TARGET, which autotools recipes never see. They get the
+    # target-prefixed driver from the same bin directory instead - otherwise the
+    # aarch64 assembly GMP generates is handed to an x86 assembler.
+    get_filename_component(ORCA_ANDROID_TOOLCHAIN_BIN "${CMAKE_C_COMPILER}" DIRECTORY)
+
+    # The NDK root, derived from the toolchain file, for recipes that need it in the
+    # environment (OpenSSL's android configuration probes $ANDROID_NDK).
+    get_filename_component(_orca_ndk_dir "${CMAKE_TOOLCHAIN_FILE}" DIRECTORY)
+    get_filename_component(_orca_ndk_dir "${_orca_ndk_dir}" DIRECTORY)
+    get_filename_component(ORCA_ANDROID_NDK "${_orca_ndk_dir}" DIRECTORY)
+    set(ORCA_ANDROID_CC  "${ORCA_ANDROID_TOOLCHAIN_BIN}/${ORCA_ANDROID_HOST}${ORCA_ANDROID_API_LEVEL}-clang")
+    set(ORCA_ANDROID_CXX "${ORCA_ANDROID_TOOLCHAIN_BIN}/${ORCA_ANDROID_HOST}${ORCA_ANDROID_API_LEVEL}-clang++")
+
+    message(STATUS "Android dependency target triple: ${ORCA_ANDROID_HOST}")
+    message(STATUS "Android dependency compiler: ${ORCA_ANDROID_CC}")
+endif ()
+
 include(ExternalProject)
 include(ProcessorCount)
 
@@ -172,6 +210,26 @@ function(orcaslicer_add_cmake_project projectname)
       set(_gen "")
     endif()
 
+    # Android: only the toolchain file and the compilers are forwarded below, so the
+    # ABI/API/STL selection has to be repeated for every ExternalProject - otherwise
+    # each dependency silently falls back to the toolchain's default ABI.
+    #
+    # These go in front, not at the back: cmake_parse_arguments() folds undeclared
+    # ExternalProject keywords (DEPENDS in Eigen.cmake, LIST_SEPARATOR in Boost.cmake)
+    # into P_ARGS_CMAKE_ARGS, and CMAKE_ARGS ends at the first keyword ExternalProject
+    # recognises - anything after that DEPENDS is read as a dependency, not as a flag.
+    if (ANDROID)
+        set(P_ARGS_CMAKE_ARGS
+            -DANDROID_ABI:STRING=${ANDROID_ABI}
+            -DANDROID_PLATFORM:STRING=${ANDROID_PLATFORM}
+            -DANDROID_STL:STRING=${ANDROID_STL}
+            # The NDK toolchain sets CMAKE_SYSROOT, which CMake uses as a find root, so
+            # every find_package would only look inside the sysroot and never see the
+            # dependency prefix this build installs into.
+            -DCMAKE_FIND_ROOT_PATH:STRING=${DESTDIR}
+            ${P_ARGS_CMAKE_ARGS})
+    endif ()
+
     if ($ENV{CMAKE_BUILD_PARALLEL_LEVEL})
       set(_build_j "")  # assume environment will control --build parallel setting
     elseif(MSVC)
