+            # invokes the LLVM tools it recorded at configure time.
+            set(_openssl_env_build env "PATH=${ORCA_ANDROID_TOOLCHAIN_BIN}:$ENV{PATH}" "ANDROID_NDK=${ORCA_ANDROID_NDK}")
+            set(_conf_cmd ${_openssl_env_build} "LDFLAGS=${CMAKE_EXE_LINKER_FLAGS}" "./Configure")
+        else()
+            set(_openssl_env_build)
+            set(_conf_cmd env "CC=${CMAKE_C_COMPILER}" "LDFLAGS=${CMAKE_EXE_LINKER_FLAGS}" "./config")
+            set(_android_api_line "")
+        endif()
     endif()
     set(_cross_comp_prefix_line "")
     set(_make_cmd make -j${NPROC})
     set(_install_cmd make -j${NPROC} install_sw)
     if (CMAKE_CROSSCOMPILING)
-        set(_cross_comp_prefix_line "--cross-compile-prefix=${TOOLCHAIN_PREFIX}-")
+        if (ANDROID)
+            # The NDK clang is already target-prefixed, so no --cross-compile-prefix.
+            set(_cross_arch "${ORCA_ANDROID_OPENSSL_TARGET}")
+        else()
+            set(_cross_comp_prefix_line "--cross-compile-prefix=${TOOLCHAIN_PREFIX}-")
 
-        if (${CMAKE_SYSTEM_PROCESSOR} STREQUAL "aarch64" OR ${CMAKE_SYSTEM_PROCESSOR} STREQUAL "arm64")
-            set(_cross_arch "linux-aarch64")
-        elseif (${CMAKE_SYSTEM_PROCESSOR} STREQUAL "armhf") # For raspbian
-            # TODO: verify
-            set(_cross_arch "linux-armv4")
-        endif ()
+            if (${CMAKE_SYSTEM_PROCESSOR} STREQUAL "aarch64" OR ${CMAKE_SYSTEM_PROCESSOR} STREQUAL "arm64")
+                set(_cross_arch "linux-aarch64")
+            elseif (${CMAKE_SYSTEM_PROCESSOR} STREQUAL "armhf") # For raspbian
+                # TODO: verify
+                set(_cross_arch "linux-armv4")
+            endif ()
+        endif()
     endif ()
 endif()
 
@@ -53,13 +76,14 @@ ExternalProject_Add(dep_OpenSSL
         "--openssldir=${DESTDIR}"
         "--prefix=${DESTDIR}"
