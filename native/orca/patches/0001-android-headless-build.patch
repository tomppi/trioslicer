+        if (ANDROID)
+            # ./config re-detects the compiler; with the NDK the target is explicit, and
+            # OpenSSL's android-* configurations want the API level on the command line.
+            string(REPLACE "android-" "" _android_api_level "${ANDROID_PLATFORM}")
+            set(_android_api_line "-D__ANDROID_API__=${_android_api_level}")
+
+            # OpenSSL's android-* configuration resolves its compiler from $ANDROID_NDK plus
+            # whatever "clang" it finds on PATH - it no longer accepts a plain CC setting,
+            # and the NDK stopped shipping gcc wrappers in r23. Point both at the NDK
